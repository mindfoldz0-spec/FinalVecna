# Copy values from your real .env — never commit .env itself.
# Colon-format aliases (sarvav:…, gnani:…, groq:…) exist only in the local
# .env; the names below are the standard ones the app reads.

# Officer login (SSM /vecna/officer/password locally; Render env var remotely)
AGENT_PASSWORD=Officer
CALL_TOKEN_SECRET=change-me-to-a-long-random-string

# Self-hosted SER model on AWS EC2 (see aws/README.md)
EMOTION_ENDPOINT=http://3.25.119.144:8080
EMOTION_API_KEY=

# Message STT: Sarvam primary, Gnani fallback; Groq LLM triage
SARVAM_API_KEY=
GNANI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# (Retired) Supabase DATABASE_URL — no longer needed.
